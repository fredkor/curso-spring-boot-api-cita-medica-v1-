<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>mx.com.fredkor.apps</groupId>
        <artifactId>api-cita-medica-v1</artifactId>
        <version>0.0.1-SNAPSHOT</version>
    </parent>

    <artifactId>cita-medica-application</artifactId>

    <properties>
        <spring-boot.repackage.skip>false</spring-boot.repackage.skip>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>mx.com.fredkor.apps</groupId>
            <artifactId>cita-medica-shared</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>mx.com.fredkor.apps</groupId>
            <artifactId>cita-medica-catalogos</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>mx.com.fredkor.apps</groupId>
            <artifactId>cita-medica-usuarios</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>mx.com.fredkor.apps</groupId>
            <artifactId>cita-medica-core</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>mx.com.fredkor.apps</groupId>
            <artifactId>cita-medica-platform</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-flyway</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

</project>
