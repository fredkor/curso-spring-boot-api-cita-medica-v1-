    },
    {
      "key": "medicoSucursalId",
      "value": "",
      "type": "string"
    },
    {
      "key": "citaId",
      "value": "",
      "type": "string"
    },
    {
      "key": "citaCancelarId",
      "value": "",
      "type": "string"
    },
    {
      "key": "fechaHoraInicio",
      "value": "",
      "type": "string"
    },
    {
      "key": "fechaHoraTermino",
      "value": "",
      "type": "string"
    },
    {
      "key": "baseUrl",
      "value": "http://localhost:8080",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "01 - Autenticación",
      "item": [
        {
          "name": "Login administrador",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/v1/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Estado HTTP esperado\", () => pm.expect(pm.response.code).to.be.oneOf([200]));",
                  "if (pm.response.code === 200) { const token = pm.response.json().token; pm.test(\"Token recibido\", () => pm.expect(token).to.be.a(\"string\").and.not.empty); if (token) pm.collectionVariables.set(\"token\", token); } else { pm.collectionVariables.unset(\"token\"); }"
                ]
              }
            },
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.unset(\"token\");",
                  "pm.collectionVariables.set(\"runId\", Date.now().toString());"
                ]
              }
            }
          ]
        }
      ]
    },
