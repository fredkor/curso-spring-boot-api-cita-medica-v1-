            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.unset(\"citaCancelarId\");",
                  "const primeraFecha = pm.variables.get(\"fechaHoraInicio\");",
                  "const primera = primeraFecha ? new Date(primeraFecha) : new Date();",
                  "if (Number.isNaN(primera.getTime())) throw new Error(\"fechaHoraInicio inválida: ejecutar primero 08 - citas / Crear\");",
                  "const inicio = new Date(Math.max(primera.getTime() + 24*60*60*1000, Date.now() + 8*24*60*60*1000));",
                  "const termino = new Date(inicio.getTime() + 30*60*1000);",
                  "const local = d => new Date(d.getTime() - d.getTimezoneOffset()*60000).toISOString().slice(0,19);",
                  "pm.variables.set(\"fechaHoraInicioCancelar\", local(inicio));",
                  "pm.variables.set(\"fechaHoraTerminoCancelar\", local(termino));"
                ]
              }
            }
          ]
