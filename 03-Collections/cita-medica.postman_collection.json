                  "pm.test(\"Estado HTTP esperado\", () => pm.expect(pm.response.code).to.be.oneOf([201]));",
                  "if (pm.response.code === 201) {",
                  " const data = pm.response.json();",
                  " pm.test(\"Identificador recibido\", () => pm.expect(data.id).to.be.a(\"number\"));",
                  " if (data.id) pm.collectionVariables.set(\"citaCancelarId\", data.id);",
                  "}"
                ]
