{
  "info": {
    "name": "Cita Médica - Suite backend",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Ejecutar carpetas 01 a 11 en orden con administrador. Crea datos y los elimina al final. Configurar rolPacienteId, medicoId y estatusCitaId según la BD. Ver README."
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "token",
      "value": "",
      "type": "string"
    },
    {
      "key": "runId",
      "value": "",
      "type": "string"
    },
    {
      "key": "rolPacienteId",
      "value": "3",
      "type": "string"
    },
    {
      "key": "medicoId",
      "value": "2",
      "type": "string"
    },
    {
      "key": "estatusCitaId",
      "value": "1",
      "type": "string"
    },
    {
      "key": "sucursalId",
      "value": "",
      "type": "string"
    },
    {
      "key": "especialidadId",
      "value": "",
      "type": "string"
    },
    {
      "key": "pacienteId",
      "value": "",
      "type": "string"
    },
    {
